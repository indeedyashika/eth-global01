# ── Required: at least one LLM provider key ─────────────────────────────────

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=

# GitHub (higher rate limits for code tools)
GITHUB_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Hedera Tokenization Platform ─────────────────────────────────────────────
# Server-side operator/treasury credentials. Never expose the private key to
# browser code or paste it into an agent conversation.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=

# Public Reown/WalletConnect project identifier, loaded by the browser at runtime
WALLETCONNECT_PROJECT_ID=

# World ID policy configured by the Setup form.
COMPLIANCE_WORLDID_REQUIRED=false
COMPLIANCE_WORLDID_SELFIE_CHECK=true
COMPLIANCE_WORLDID_IDENTITY_CHECK=false
COMPLIANCE_WORLDID_AGE_ENABLED=false
COMPLIANCE_WORLDID_MINIMUM_AGE=18
COMPLIANCE_WORLDID_NATIONALITY_ENABLED=false
# Optional ISO 3166-1 alpha-3 nationality, e.g. PRT, USA, JPN.
COMPLIANCE_WORLDID_NATIONALITY=

# Optional recurring Selfie Check. The minimum is 60 seconds; 300 is useful
# for a five-minute demo, while 7776000 represents 90 days.
COMPLIANCE_LIVENESS_ENABLED=false
COMPLIANCE_LIVENESS_PERIOD_SECONDS=2592000
# How often the internal deterministic expiry worker checks for stale holders.
LIVENESS_SWEEP_INTERVAL_SECONDS=15

# Optional canonical URL used in wallet DApp metadata
# TOKENIZATION_APP_URL=https://your-service.up.railway.app/tokenization

# ── Ethereum Sepolia operator ────────────────────────────────────────────────
# Used by the platform and the `evm` MCP. Never expose this private key to chat
# or client-side code. The operator address is the ERC-20 treasury.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_OPERATOR_PRIVATE_KEY=

# ── Subgraph MCP (The Graph) ─────────────────────────────────────────────────
# Powers the `subgraph` agent tools (query ERC20 transfer data indexed on
# Ethereum Sepolia, and add/remove tracked tokens). Set SUBGRAPH_URL to your
# Graph Studio query endpoint using the STABLE "version/latest" path segment
# (NOT the version-pinned URL Studio's Details tab shows by default), so it keeps
# resolving to the most recent deploy after every add_token_source/set_token_sources:
#   https://api.studio.thegraph.com/query/<id>/<name>/version/latest
SUBGRAPH_URL=
# Deploy key from the subgraph's Graph Studio page — required only for the
# deploy tools (add_token_source / set_token_sources); queries work without it.
GRAPH_DEPLOY_KEY=
# The subgraph name in Graph Studio (deploy target). Defaults to sepolia-test.
GRAPH_SUBGRAPH_NAME=sepolia-test
# get_latest_sepolia_block reuses SEPOLIA_RPC_URL above.

# ── Gateway security ──────────────────────────────────────────────────────────
# Set to false and configure allowlists if you want to restrict access
GATEWAY_ALLOW_ALL_USERS=true

# ── Terminal backend ──────────────────────────────────────────────────────────
# Options: local, docker, modal, ssh
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
