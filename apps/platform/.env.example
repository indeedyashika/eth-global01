# Hedera operator / treasury (server-side secrets)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=

# Ethereum Sepolia operator / treasury (server-side only)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_OPERATOR_PRIVATE_KEY=0x...

# Public WalletConnect/Reown project identifier, served to the browser at runtime
WALLETCONNECT_PROJECT_ID=

# Optional canonical public URL used in WalletConnect DApp metadata
# TOKENIZATION_APP_URL=https://your-service.up.railway.app/tokenization

# Local development database. The integrated container overrides this with
# /data/tokenization/tokenization.db on the persistent Railway volume.
DATABASE_PATH=./data/tokenization.db

# World ID credential verification
# Selfie Check uses the production World App; Identity Check uses staging
# with the World Simulator. The RP signing key must remain server-side.
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxx
# Runtime alias used by the standalone Railway server (same value as above)
WORLD_APP_ID=app_xxxxx
WORLD_RP_ID=rp_xxxxx
WORLD_RP_SIGNING_KEY=0x...
WORLD_ACTION=selfie-check-demo
WORLD_IDENTITY_ACTION=identity-check-demo
NEXT_PUBLIC_WORLD_SIGNAL=rwa-marketplace-holder
